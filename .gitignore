# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# lockfile policy (pnpm only)
package-lock.json
**/package-lock.json
**/bun.lock
**/bun.lockb

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
**/.vscode/
!/.vscode/
/.vscode/*
!/.vscode/settings.json
!/.vscode/tasks.json

# Cursor local state
.cursor/

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Environment files - NEVER commit these
.env
.env.local
.env.*.local
*.pem

# AI assistant local docs/config
AGENTS.md
agents.md
CLAUDE.md
claude.md
.claude/settings.local.json
!/AGENTS.md
!/CLAUDE.md

# Agent worktrees. Scratch checkouts of this same repo, so anything committed
# from here would be a duplicate -- and left visible they break more than git
# hygiene: nx globs them, finds every project defined twice, and refuses to
# build the graph at all, which takes the whole dev server down with it.
**/.claude/worktrees/

# Generated cross-tool skill adapters. Canonical, reviewed skills live in
# .agents; Claude's checked-in links point back to that single source.
/.*/skills/
/.tabnine/agent/skills/
!/.agents/skills/
!/.agents/skills/**
/skills/
/data/skills/

.nx/cache
.nx/workspace-data

.turbo/

# Meta-repo safety: block generated artifacts from nested repos
**/node_modules/
**/.turbo/
**/.nx/cache/
**/.nx/workspace-data/
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/*.log


# Local teach-skill learning records (never sync)
learning-records/

