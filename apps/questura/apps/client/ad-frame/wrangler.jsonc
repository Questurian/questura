// The `questura-ad-frame` Worker: ads.questurian.com serves the document each
// banner runs in, so ad code gets an origin of its own (see
// src/features/ads/lib/adFrameResponse.ts and docs/procedures/ads.md).
//
// Deploy from apps/questura/apps/client:
//   pnpm exec wrangler deploy --config ad-frame/wrangler.jsonc
// It changes only when the ad frame document or the Adsterra script address
// does; the site's own Worker deploys separately.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "questura-ad-frame",
  "main": "worker.ts",
  "compatibility_date": "2026-09-22",

  // Only its own address: no *.workers.dev copy.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ads.questurian.com", "custom_domain": true }],

  // adUnits.ts reads NODE_ENV for its development outlines; a Worker has no
  // `process`, so fix it at build time.
  "define": { "process.env.NODE_ENV": "\"production\"" },

  "observability": { "enabled": true }
}
