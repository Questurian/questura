{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "questura-client",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "questura-server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/questura/apps/server",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    }
  ]
}
